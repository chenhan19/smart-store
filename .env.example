# 复制此文件为 .env 并填写真实值
# cp .env.example .env

# MySQL
MYSQL_ROOT_PASSWORD=smart_shop_root
MYSQL_DATABASE=smart_shop
MYSQL_USER=smart_shop_user
MYSQL_PASSWORD=smart_shop_pass

# Server
DB_HOST=mysql
DB_PORT=3306
DB_NAME=smart_shop
DB_USER=smart_shop_user
DB_PASS=smart_shop_pass
JWT_SECRET=change_this_to_a_long_random_secret
WX_APP_ID=your_wx_app_id
WX_APP_SECRET=your_wx_app_secret
PORT=3000
NODE_ENV=production

# Miniapp (构建时注入)
TARO_APP_API_URL=http://localhost:3000
