{
  "name": "smart-shop",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:miniapp": "pnpm --filter @smart-shop/miniapp dev:weapp",
    "dev:server": "pnpm --filter @smart-shop/server dev",
    "docker:dev": "docker compose -f docker-compose.dev.yml --env-file .env.dev up",
    "docker:dev:build": "docker compose -f docker-compose.dev.yml --env-file .env.dev up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:up": "docker compose --env-file .env up -d",
    "docker:up:build": "docker compose --env-file .env up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose -f docker-compose.dev.yml logs -f"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
