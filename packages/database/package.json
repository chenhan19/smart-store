{
  "name": "@smart-store/database",
  "version": "1.0.0",
  "description": "Database configuration and Prisma schema for Smart Store",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
